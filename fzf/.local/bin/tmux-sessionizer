#!/usr/bin/env bash
# ThePrimeagen-style sessionizer: fuzzy-pick a project directory, then create
# (or reuse) a tmux session named after it and jump there — from a plain
# shell or from inside tmux.

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(find ~/Documents/Repos -mindepth 1 -maxdepth 1 -type d | fzf)
fi

[[ -z $selected ]] && exit 0

# tmux session names can't contain dots
selected_name=$(basename "$selected" | tr . _)

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -z $TMUX ]]; then
  tmux attach-session -t "$selected_name"
else
  tmux switch-client -t "$selected_name"
fi
